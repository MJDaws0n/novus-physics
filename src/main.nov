module physics;

fn aabb_check(ax: i32, ay: i32, aw: i32, ah: i32, pe: i32, pf: i32, pg: i32, ph: i32) -> i32 {
    if (ax + aw < pe || pe + pg < ax || ay + ah < pf || pf + ph < ay) {
        return 0;
    }
    return 1;
}

fn clamp(val: i32, min_val: i32, max_val: i32) -> i32 {
    if (val < min_val) {
        return min_val;
    }
    if (val > max_val) {
        return max_val;
    }
    return val;
}

fn distance_squared(dx: i32, dy: i32) -> i32 {
    return (dx * dx) + (dy * dy);
}
