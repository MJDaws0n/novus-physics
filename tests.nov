module physics_tests;

import main physics;

fn expect_eq(actual: i32, expected: i32, fails: i32) -> i32 {
    if (actual == expected) {
        return fails;
    }
    return fails + 1;
}

fn main() -> i32 {
    let fails: i32 = 0;
    let next_fails: i32 = expect_eq(physics.aabb_check(0, 0, 16, 16, 8, 8, 16, 16), 1, fails);
    let final_fails: i32 = expect_eq(physics.aabb_check(0, 0, 16, 16, 64, 64, 16, 16), 0, next_fails);

    if (final_fails > 0) {
        return 1;
    }
    return 0;
}
